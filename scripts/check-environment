#!/usr/bin/env python3
"""Read-only DMS widget preflight; never changes settings or starts a session."""
import os
from pathlib import Path
import sys


def file_picker(source):
    if (source / 'DankCommon/FileBrowser/FilePicker.qml').is_file():
        return 'modern (DankCommon.FileBrowser.FilePicker)'
    if (source / 'DankCommon/Modals/FileBrowser/FileBrowserContent.qml').is_file():
        return 'legacy (DankCommon.Modals.FileBrowser.FileBrowserContent)'
    legacy = source / 'Modals/FileBrowser/FileBrowserContent.qml'
    if legacy.is_file():
        # Some DMS versions only ship a wrapper around the shared component.
        if 'qs.DankCommon.Modals.FileBrowser' in legacy.read_text() and not (
                source / 'DankCommon/Modals/FileBrowser/FileBrowserContent.qml').is_file():
            return None
        return 'legacy (Modals.FileBrowser.FileBrowserContent)'
    return None


def check_widgets(source):
    missing = [name for name in ('DankPopout', 'DankFloatingWindow')
               if not (source / 'Widgets' / (name + '.qml')).is_file()]
    if not file_picker(source):
        missing.append('FilePicker / FileBrowserContent (including DankCommon)')
    return missing


def main():
    configured = os.environ.get('DANKCHAT_DMS_SOURCE')
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    candidates = [Path(configured)] if configured else sorted(
        (runtime / 'danklinux-shell').glob('*/shell.qml'), key=lambda p: p.stat().st_mtime, reverse=True)
    sources = [p.parent if p.name == 'shell.qml' else p for p in candidates]
    sources += [] if configured else [Path('/usr/share/quickshell/dms')]
    source = next((p for p in sources if (p / 'Widgets').is_dir()), None)
    if source is None:
        print('Cannot locate DMS sources. Set DANKCHAT_DMS_SOURCE to the directory containing shell.qml and Widgets.')
        return 1
    missing = check_widgets(source)
    if missing:
        print('Missing DMS widgets: ' + ', '.join(missing) + '. Update DMS to 1.6.1 or newer, restart the shell, then enable DankChat.')
        return 1
    print('DMS component files available: ' + str(source))
    print('File picker: ' + file_picker(source))
    print('This checks component files only; use scripts/test-ui to check QML loading.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
