#!/usr/bin/env python3
"""Regenerate the offline Emoji 17.0 catalog with CLDR 48 search annotations."""
import hashlib
import json
from pathlib import Path
import re
import unicodedata
from urllib.request import urlopen
import xml.etree.ElementTree as ET

ROOT = Path(__file__).resolve().parents[1]
sources = {}
def fetch(url):
    data = urlopen(url, timeout=45).read()
    sources[url] = hashlib.sha256(data).hexdigest()
    return data.decode('utf-8')

def key(text):
    return text.replace('\ufe0f', '')

def normalize(text):
    return ''.join(c for c in unicodedata.normalize('NFD', text.lower().replace('ß', 'ss')) if not unicodedata.combining(c))

annotations = {}
for language in ('en', 'de'):
    for directory in ('annotations', 'annotationsDerived'):
        url = f'https://raw.githubusercontent.com/unicode-org/cldr/release-48/common/{directory}/{language}.xml'
        for node in ET.fromstring(fetch(url)).iter('annotation'):
            text = node.text or ''
            if text in ('↑↑↑', '∅∅∅'):
                continue
            annotations.setdefault(key(node.attrib['cp']), []).append(text)

catalog = fetch('https://www.unicode.org/Public/17.0.0/emoji/emoji-test.txt')
entries = []
groups = []
for line in catalog.splitlines():
    if line.startswith('# group: '):
        group = line.removeprefix('# group: ')
        groups.append(group)
    match = re.match(r'^([0-9A-F ]+)\s*;\s*(fully-qualified|component)\s*#\s*\S+\s+E[\d.]+\s+(.+)$', line)
    if not match:
        continue
    emoji = ''.join(chr(int(cp, 16)) for cp in match[1].split())
    name = match[3]
    words = [emoji, name] + annotations.get(key(emoji), [])
    # Compound variants also inherit the base emoji's German/English keywords.
    base = ''.join(c for c in emoji if not 0x1F3FB <= ord(c) <= 0x1F3FF)
    words += annotations.get(key(base), [])
    entries.append([emoji, groups.index(group), name, normalize(' '.join(words))])
assert len(entries) == 3953, len(entries)
output = '// Generated by scripts/update-emoji-data. Unicode License v3: data/unicode/LICENSE.\n.pragma library\n'
output += 'var groups = ' + json.dumps(groups, ensure_ascii=False) + ';\n'
output += 'var entries = ' + json.dumps(entries, ensure_ascii=False, separators=(',', ':')) + ';\n'
output += '''
function normalize(text) {
    return text.toLowerCase().replace(/ß/g, "ss").normalize("NFD").replace(/[\\u0300-\\u036f]/g, "");
}
function search(query, category) {
    var words = normalize(query.trim()).split(/\\s+/).filter(function(word) { return word.length > 0; });
    return entries.filter(function(entry) {
        return (words.length > 0 || category < 0 || entry[1] === category)
            && words.every(function(word) { return entry[3].indexOf(word) !== -1; });
    });
}
'''
(ROOT / 'emoji-data.js').write_text(output)
(ROOT / 'data/unicode/LICENSE').write_text(fetch('https://www.unicode.org/license.txt'))
(ROOT / 'data/unicode/sources.json').write_text(json.dumps({'emoji_version': '17.0', 'cldr_release': '48', 'entries': len(entries), 'sha256': sources}, indent=2) + '\n')
print(f'Generated {len(entries)} emoji across {len(groups)} categories')
